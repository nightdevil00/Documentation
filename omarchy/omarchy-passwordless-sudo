#!/usr/bin/env bash
# Re-enable permanent passwordless sudo for your user (e.g. after reinstalling
# Omarchy, or on a fresh machine).
#
# Installs /etc/sudoers.d/99-<user>-nopasswd containing:
#   <user> ALL=(ALL) NOPASSWD: ALL
#
# The rule is validated with visudo before and after installation, and removed
# again if validation fails, so it cannot lock you out of sudo.
#
# Usage:   omarchy-passwordless-sudo
# Disable: sudo rm /etc/sudoers.d/99-<user>-nopasswd

set -euo pipefail

TARGET_USER="${SUDO_USER:-$(id -un)}"

if [[ "$TARGET_USER" == "root" ]]; then
  echo "error: run this as your normal user, not as root (the script asks for sudo itself)." >&2
  exit 1
fi

RULE_FILE="/etc/sudoers.d/99-${TARGET_USER}-nopasswd"
TMP_RULE="$(mktemp)"
trap 'rm -f "$TMP_RULE"' EXIT

printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$TARGET_USER" > "$TMP_RULE"
chmod 600 "$TMP_RULE"

read -r -d '' ROOT_SCRIPT <<'EOS' || true
set -e
rule_file=$1
tmp_rule=$2

if ! grep -qE '^[@#]includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers; then
  echo "error: /etc/sudoers does not include /etc/sudoers.d" >&2
  exit 1
fi

# Sanity-check the candidate rule on its own before it goes live.
if ! visudo -cf "$tmp_rule" >/dev/null 2>&1; then
  echo "error: candidate rule failed validation; nothing installed" >&2
  visudo -cf "$tmp_rule" >&2 || true
  exit 1
fi

install -m 0440 -o root -g root "$tmp_rule" "$rule_file"

# Confirm the whole sudoers configuration still parses.
if ! visudo -c >/dev/null 2>&1; then
  echo "error: sudoers config invalid after install; removing $rule_file" >&2
  rm -f "$rule_file"
  exit 1
fi
EOS

echo "Installing $RULE_FILE ..."

if sudo -n true 2>/dev/null || [[ -t 0 ]]; then
  sudo sh -c "$ROOT_SCRIPT" sh "$RULE_FILE" "$TMP_RULE"
else
  pkexec sh -c "$ROOT_SCRIPT" sh "$RULE_FILE" "$TMP_RULE"
fi

if sudo -n true 2>/dev/null; then
  echo "success: passwordless sudo is enabled for $TARGET_USER"
  echo "revoke with: sudo rm $RULE_FILE"
else
  echo "error: rule installed, but sudo still asks for a password." >&2
  echo "check it with: sudo visudo -c" >&2
  exit 1
fi
